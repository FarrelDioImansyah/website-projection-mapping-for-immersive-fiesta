{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/js/env.js",
      "dest": "/js/env.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
